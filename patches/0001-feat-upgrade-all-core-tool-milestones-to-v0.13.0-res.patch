+    assert_eq!(replies[1]["result"]["tools"].as_array().unwrap().len(), tools().len());
+    assert_eq!(replies[2]["result"]["structuredContent"]["pages"], 3);
+    assert_eq!(replies[2]["result"]["isError"], false);
+    let img = &replies[3]["result"]["content"][0];
