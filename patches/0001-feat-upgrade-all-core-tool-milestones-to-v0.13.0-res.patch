+    assert!(!before.1 && before.4.is_some(), "a clean document with a step to redo: {before:?}");
+    for (key, value) in [
+        ("font", json!("times")),
+        ("size", json!(24)),
+        ("bold", json!(true)),
+        ("italic", json!(true)),
+        ("color", json!("red")),
+        ("align", json!("center")),
+    ] {
+        for rect in [None, Some(json!([20, 100, 50, 130]))] {
+            let mut args = json!({ "doc": doc, "page": 1, "index": 2 });
