+#[cfg(feature = "mcp")]
+fn rpc(server: &mut McpServer, id: u64, method: &str, params: Value) -> Value {
+    let line = json!({ "jsonrpc": "2.0", "id": id, "method": method, "params": params }).to_string();
+    serde_json::from_str(&server.handle_line(&line).expect("a reply")).unwrap()
+}
