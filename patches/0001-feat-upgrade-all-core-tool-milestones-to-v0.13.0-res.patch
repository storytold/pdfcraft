+        &[
+            b"<< /Length 11 >>\nstream\n<template/>\nendstream",
+            b"<< /Length 22 >>\nstream\n<xfa:datasets><a>1</a>\nendstream",
+            b"<< /Length 7 >>\nstream\n<form/>\nendstream",
+        ],
+    )
