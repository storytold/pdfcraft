+fn page_text(a: &mut Automation, doc: u64) -> Vec<String> {
+    ok(a, "text_extract", json!({ "doc": doc }))["pages"].as_array().unwrap().iter().map(|p| p["text"].as_str().unwrap().trim().to_string()).collect()
+}
