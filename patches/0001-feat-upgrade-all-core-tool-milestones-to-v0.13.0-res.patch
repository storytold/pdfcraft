+        let mut enc = png::Encoder::new(&mut png, 1, 1);
+        enc.set_color(png::ColorType::Rgb);
+        enc.write_header().unwrap().write_image_data(&[80, 160, 200]).unwrap();
+    }
+    std::fs::write(dir.join("logo.png"), png).unwrap();
