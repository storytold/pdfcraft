+fn tagged_figure_two_streams(after_figure: &str, second: &str) -> Document {
+    let figure = "/Figure << /MCID 0 >> BDC q 50 0 0 50 72 600 cm /Im1 Do Q EMC\n";
+    let first = format!("{figure}{after_figure}");
+    build_pdf(&[
