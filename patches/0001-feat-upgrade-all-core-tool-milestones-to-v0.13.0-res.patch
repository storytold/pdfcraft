+            let first = bm
+                .as_name()
+                .map(<[u8]>::to_vec)
+                .or_else(|| bm.as_array().and_then(|a| a.iter().find_map(|o| doc.resolve(o).as_name().map(<[u8]>::to_vec))));
+            if let Some(name) = first {
+                self.blend = if name == b"Compatible" { b"Normal".to_vec() } else { name };
+            }
+        }
