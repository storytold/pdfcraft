+    let i = bad.windows(8).position(|w| w == b"(Legacy)").unwrap() + 1;
+    bad[i] = b'l';
+    let s = signatures(&open(&bad), &bad, &trusted).into_iter().find(|s| s.signed).unwrap();
+    assert_eq!(s.status, Status::Invalid, "{:?}", s.details);
