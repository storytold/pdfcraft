+/// 32 fresh bytes for the file key. `RandomState` is seeded by the operating system (as the
+/// engine's `entropy` uses it), so every run encrypts with a different key.
+fn seed() -> [u8; 32] {
+    use std::hash::{BuildHasher, Hasher};
