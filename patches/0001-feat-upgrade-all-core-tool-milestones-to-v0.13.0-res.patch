+            let mut dict = Vec::new();
+            dict.extend(int(charset));
+            dict.push(15);
+            dict.extend(int(char_strings));
+            dict.push(17);
+            dict.extend(int(0));
+            dict.extend(int(private));
+            dict.push(18);
