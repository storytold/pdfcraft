+    });
+    let s = signatures(&open(&edited), &edited, &TrustStore::default()).into_iter().find(|s| s.signed).unwrap();
+    assert!(matches!(s.modification, Modification::Allowed(_)), "{:?}", s.modification);
+    assert_eq!(s.status, Status::Unknown, "{:?}", s.details);
