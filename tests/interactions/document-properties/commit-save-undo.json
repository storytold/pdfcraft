{
  "schema": 1,
  "name": "Document Properties: commit-save-undo",
  "steps": [
    {
      "event": {"op": "open"},
      "expect": {"error": null, "properties_open": true, "document": {"title": "Original", "author": "Original author", "custom": {"Untouched": "Keep me"}, "display_title": false, "dirty": false, "undo": null, "redo": null, "pages": 2, "custom_count": 1}, "original_bytes": true}
    },
    {
      "event": {"op": "type", "field": "Title", "value": "Preview 1"},
      "expect": {"error": null, "draft": {"title": "Preview 1"}, "document": {"title": "Original", "author": "Original author", "custom": {"Untouched": "Keep me"}, "display_title": false, "dirty": false, "undo": null, "redo": null, "pages": 2, "custom_count": 1}, "original_bytes": true}
    },
    {
      "event": {"op": "type", "field": "Title", "value": "Published title"},
      "expect": {"error": null}
    },
    {
      "event": {"op": "type", "field": "Author", "value": "Review team"},
      "expect": {"error": null}
    },
    {
      "event": {"op": "click", "label": "Custom"},
      "expect": {"error": null}
    },
    {
      "event": {"op": "type", "field": "Name:", "value": "Project"},
      "expect": {"error": null}
    },
    {
      "event": {"op": "type", "field": "Value:", "value": "PdfCraft"},
      "expect": {"error": null}
    },
    {
      "event": {"op": "click", "label": "Add"},
      "expect": {"error": null, "draft": {"custom": {"Project": "PdfCraft", "Untouched": "Keep me"}}, "document": {"title": "Original", "author": "Original author", "custom": {"Untouched": "Keep me"}, "display_title": false, "dirty": false, "undo": null, "redo": null, "pages": 2, "custom_count": 1}, "original_bytes": true}
    },
    {
      "event": {"op": "click", "label": "Initial View"},
      "expect": {"error": null}
    },
    {
      "event": {"op": "click", "label": "Document Title"},
      "expect": {"error": null, "draft": {"display_title": true}, "document": {"title": "Original", "author": "Original author", "custom": {"Untouched": "Keep me"}, "display_title": false, "dirty": false, "undo": null, "redo": null, "pages": 2, "custom_count": 1}, "original_bytes": true}
    },
    {
      "event": {"op": "click", "label": "OK"},
      "expect": {"error": null, "properties_open": false, "draft": null, "document": {"title": "Published title", "author": "Review team", "custom": {"Project": "PdfCraft", "Untouched": "Keep me"}, "display_title": true, "dirty": true, "undo": "Change document properties", "redo": null, "custom_count": 2}}
    },
    {
      "event": {"op": "undo"},
      "expect": {"error": null, "document": {"title": "Original", "author": "Original author", "custom": {"Untouched": "Keep me"}, "display_title": false, "undo": null, "redo": "Change document properties", "custom_count": 1}}
    },
    {
      "event": {"op": "redo"},
      "expect": {"error": null, "document": {"title": "Published title", "author": "Review team", "display_title": true, "undo": "Change document properties", "redo": null}}
    },
    {
      "event": {"op": "save_reopen"},
      "expect": {"error": null, "reopened": {"title": "Published title", "author": "Review team", "custom": {"Project": "PdfCraft", "Untouched": "Keep me"}, "display_title": true, "dirty": false, "pages": 2, "undo": null, "redo": null, "custom_count": 2}}
    }
  ]
}
