{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PdfCraft",
  "version": "0.6.0",
  "identifier": "org.pdfcraft.mobile",
  "build": {
    "devUrl": "http://localhost:8766",
    "frontendDist": "../../../dist/mobile"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PdfCraft",
        "width": 420,
        "height": 840
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "capabilities": [
        "mobile"
      ]
    }
  },
  "bundle": {
    "active": true,
    "resources": ["../NOTICE.txt", "../LICENSE-MPL-2.0.txt", "../../../dist/mobile/THIRD-PARTY-NOTICES.txt"],
    "icon": [
      "../../../assets/app-icon/pdfcraft-1024.png",
      "../../../assets/app-icon/pdfcraft.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "PDF document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  }
}
