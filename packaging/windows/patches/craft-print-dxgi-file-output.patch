+/// Render a print-ready PDF through the native Windows DXGI pipeline into a new file.
+/// This is an explicit destination, never a fallback, and supports one copy per output file.
+/// Callers own confinement, temporary staging and publication of the driver-created result.
+pub fn submit_to_file(pdf: &[u8], job: &Job, output: &std::path::Path) -> Result<String, Error> {
+    if job.copies != 1 {
+        return Err(Error::Spool("DXGI file output requires exactly one copy".into()));
+    }
+    #[cfg(windows)]
+    { windows::submit_to_file(pdf, job, output) }
+    #[cfg(not(windows))]
+    {
+        let _ = (pdf, job, output);
+        Err(Error::Spool("DXGI file output is available only on Windows".into()))
+    }
+}
