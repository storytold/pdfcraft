+//! Content-free diagnostics for the three native print-job initialization calls.
+//!
+//! This module needs no Windows APIs. The caller supplies the native HRESULT and retains
+//! the original error, so a localized message is never parsed to determine a cause.
+
+use std::error::Error;
+use std::fmt;
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+/// The native call starting a DXGI print job; excludes document loading and completion.
+pub enum JobInitStage {
+    /// Instantiate the package-target COM factory.
+    PackageTargetFactory,
+    /// Ask that factory to start the job and return its package target.
+    PackageTarget,
+    /// Create the Direct2D control for the package target.
+    PrintControl,
+    /// Create a new file-backed output stream without replacing an existing file.
+    OutputStreamCreateNew,
+    /// Put the new stream at byte zero, as the package-target API requires.
+    OutputStreamSeekToStart,
+}
+
+impl fmt::Display for JobInitStage {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(match self {
+            Self::PackageTargetFactory => "CoCreateInstance(PrintDocumentPackageTargetFactory)",
+            Self::PackageTarget => "CreateDocumentPackageTargetForPrintJob",
+            Self::PrintControl => "ID2D1Device::CreatePrintControl",
+            Self::OutputStreamCreateNew => "SHCreateStreamOnFileEx(CREATE_NEW)",
+            Self::OutputStreamSeekToStart => "IStream::Seek(FILE_BEGIN)",
+        })
+    }
+}
+
+/// The reported native category. Cancellation does not identify who canceled or why.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeFailureKind {
+    /// The native API reported print or operation cancellation; the actor is unknown.
+    Canceled,
+    /// The native API reported a timeout; this does not identify a particular waiter.
+    TimedOut,
+    /// A different or unknown HRESULT, preserved without inferring a cause.
+    Other,
+}
+
+/// Classify an HRESULT, never a localized error message or an unwrapped Win32 number.
+pub fn classify_hresult(hresult: i32) -> NativeFailureKind {
+    match hresult as u32 {
+        0x8007003F | 0x800704C7 => NativeFailureKind::Canceled,
+        0x800705B4 => NativeFailureKind::TimedOut,
+        _ => NativeFailureKind::Other,
+    }
+}
+
+#[derive(Debug)]
+/// A failed initialization call with content-free context and its untouched native error.
+pub struct JobInitError<E> {
+    stage: JobInitStage,
+    elapsed: Duration,
+    hresult: i32,
+    source: E,
+}
+
+impl<E> JobInitError<E> {
+    /// The exact native call that returned an error.
+    pub fn stage(&self) -> JobInitStage {
+        self.stage
+    }
+
+    /// Time spent inside this one call, not the whole print job or completion waiter.
+    pub fn elapsed(&self) -> Duration {
+        self.elapsed
+    }
+
+    /// The original signed HRESULT with every bit preserved.
+    pub fn hresult(&self) -> i32 {
+        self.hresult
+    }
+
+    /// The native category, without attributing cancellation to a person or file.
+    pub fn kind(&self) -> NativeFailureKind {
+        classify_hresult(self.hresult)
+    }
+}
+
+impl<E> fmt::Display for JobInitError<E> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(
+            f,
+            "{} failed after {} ms (HRESULT 0x{:08X})",
+            self.stage,
+            self.elapsed.as_millis(),
+            self.hresult as u32
+        )
+    }
+}
+
+impl<E: Error + 'static> Error for JobInitError<E> {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        Some(&self.source)
+    }
+}
+
+/// The outcome reported for one observed native call.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum JobInitOutcome {
+    /// Emitted and flushed by the caller before entering the native API.
+    Begin,
+    /// The native wrapper returned Ok; a successful HRESULT is not invented.
+    Succeeded,
+    /// The native wrapper returned its original error.
+    Failed,
+}
+
+/// Content-free observation of one native initialization call.
+#[derive(Clone, Copy, Debug)]
+pub struct JobInitEvent {
+    /// The exact native call being observed.
+    pub stage: JobInitStage,
+    /// Whether it begins, succeeds, or fails.
+    pub outcome: JobInitOutcome,
+    /// Time inside this call; absent for Begin.
+    pub elapsed: Option<Duration>,
+    /// Native failure HRESULT only; absent for Begin and success.
+    pub hresult: Option<i32>,
+}
+
+/// Invoke once, preserving ordering, original native error and HRESULT.
+pub(super) fn at_job_init_with_observer<T, E>(
+    stage: JobInitStage,
+    call: impl FnOnce() -> Result<T, E>,
+    hresult: impl FnOnce(&E) -> i32,
+    observer: &mut dyn FnMut(JobInitEvent),
+) -> Result<T, JobInitError<E>> {
+    observer(JobInitEvent {
+        stage,
+        outcome: JobInitOutcome::Begin,
+        elapsed: None,
+        hresult: None,
+    });
+    let start = Instant::now();
+    match call() {
+        Ok(value) => {
+            observer(JobInitEvent {
+                stage,
+                outcome: JobInitOutcome::Succeeded,
+                elapsed: Some(start.elapsed()),
+                hresult: None,
+            });
+            Ok(value)
+        }
+        Err(source) => {
+            let elapsed = start.elapsed();
+            let hresult = hresult(&source);
+            observer(JobInitEvent {
+                stage,
+                outcome: JobInitOutcome::Failed,
+                elapsed: Some(elapsed),
+                hresult: Some(hresult),
+            });
+            Err(JobInitError {
+                stage,
+                elapsed,
+                hresult,
+                source,
+            })
+        }
+    }
+}
+
+#[cfg(test)]
+pub(super) fn at_job_init<T, E>(
+    stage: JobInitStage,
+    call: impl FnOnce() -> Result<T, E>,
+    hresult: impl FnOnce(&E) -> i32,
+) -> Result<T, JobInitError<E>> {
+    at_job_init_with_observer(stage, call, hresult, &mut |_| {})
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
+mod tests {
+    use super::*;
+    use std::cell::Cell;
+
+    #[derive(Debug, PartialEq)]
+    struct NativeFailure(i32);
+
+    impl fmt::Display for NativeFailure {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            f.write_str("synthetic native failure")
+        }
+    }
+
+    impl Error for NativeFailure {}
+
+    #[test]
+    fn each_failed_call_has_its_own_stage_and_keeps_hresult_and_source() {
+        for (stage, label) in [
+            (
+                JobInitStage::PackageTargetFactory,
+                "CoCreateInstance(PrintDocumentPackageTargetFactory)",
+            ),
+            (
+                JobInitStage::PackageTarget,
+                "CreateDocumentPackageTargetForPrintJob",
+            ),
+            (
+                JobInitStage::PrintControl,
+                "ID2D1Device::CreatePrintControl",
+            ),
+        ] {
+            let calls = Cell::new(0);
+            let code = 0x8007003F_u32 as i32;
+            let error = at_job_init(
+                stage,
+                || {
+                    calls.set(calls.get() + 1);
+                    Err::<(), _>(NativeFailure(code))
+                },
+                |e| e.0,
+            )
+            .unwrap_err();
+            assert_eq!(calls.get(), 1);
+            assert_eq!(error.stage(), stage);
+            assert_eq!(error.hresult(), code);
+            assert_eq!(error.kind(), NativeFailureKind::Canceled);
+            assert!(error.to_string().contains(label), "{error}");
+            assert!(error.to_string().contains("0x8007003F"), "{error}");
+            assert!(error
+                .to_string()
+                .contains(&format!("{} ms", error.elapsed().as_millis())));
+            assert_eq!(
+                error
+                    .source()
+                    .and_then(|e| e.downcast_ref::<NativeFailure>()),
+                Some(&NativeFailure(code))
+            );
+        }
+    }
+
+    #[test]
+    fn success_is_returned_once_without_reading_an_hresult() {
+        let calls = Cell::new(0);
+        let value = at_job_init(
+            JobInitStage::PackageTarget,
+            || {
+                calls.set(calls.get() + 1);
+                Ok::<_, NativeFailure>(17)
+            },
+            |_| panic!("HRESULT must only be read on failure"),
+        )
+        .unwrap();
+        assert_eq!(value, 17);
+        assert_eq!(calls.get(), 1);
+    }
+
+    #[test]
+    fn observer_reports_begin_then_failure_with_original_hresult() {
+        for stage in [
+            JobInitStage::PackageTargetFactory,
+            JobInitStage::PackageTarget,
+            JobInitStage::PrintControl,
+        ] {
+            let mut seen = Vec::new();
+            let code = 0x8007003F_u32 as i32;
+            let failure = at_job_init_with_observer(
+                stage,
+                || Err::<(), _>(NativeFailure(code)),
+                |e| e.0,
+                &mut |event| seen.push(event),
+            )
+            .unwrap_err();
+            assert_eq!(seen.len(), 2);
+            assert_eq!(seen[0].stage, stage);
+            assert_eq!(seen[0].outcome, JobInitOutcome::Begin);
+            assert!(seen[0].elapsed.is_none() && seen[0].hresult.is_none());
+            assert_eq!(seen[1].stage, stage);
+            assert_eq!(seen[1].outcome, JobInitOutcome::Failed);
+            assert_eq!(seen[1].hresult, Some(code));
+            assert_eq!(seen[1].elapsed, Some(failure.elapsed()));
+        }
+    }
+
+    #[test]
+    fn observer_success_never_invents_an_hresult() {
+        let mut seen = Vec::new();
+        let value = at_job_init_with_observer(
+            JobInitStage::PrintControl,
+            || Ok::<_, NativeFailure>(7),
+            |_| panic!("success has no native failure HRESULT"),
+            &mut |event| seen.push(event),
+        )
+        .unwrap();
+        assert_eq!(value, 7);
+        assert_eq!(
+            seen.iter().map(|e| e.outcome).collect::<Vec<_>>(),
+            [JobInitOutcome::Begin, JobInitOutcome::Succeeded]
+        );
+        assert!(seen[1].elapsed.is_some() && seen[1].hresult.is_none());
+    }
+
+    #[test]
+    fn canceled_timeout_and_unrelated_errors_are_distinct() {
+        for (code, expected) in [
+            (0x8007003F_u32, NativeFailureKind::Canceled),
+            (0x800704C7, NativeFailureKind::Canceled),
+            (0x800705B4, NativeFailureKind::TimedOut),
+            (0x80070002, NativeFailureKind::Other),
+            (0x80070005, NativeFailureKind::Other),
+            (0x80010106, NativeFailureKind::Other),
+            (0x0000003F, NativeFailureKind::Other),
+            (0x00000000, NativeFailureKind::Other),
+            (0x00000001, NativeFailureKind::Other),
+        ] {
+            assert_eq!(classify_hresult(code as i32), expected, "0x{code:08X}");
+        }
+    }
+}
