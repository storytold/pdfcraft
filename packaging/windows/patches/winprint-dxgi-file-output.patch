+//! A bounded, non-normalizing path for a native CREATE_NEW output stream.
+use std::{
+    os::windows::ffi::OsStrExt,
+    path::{Path, PathBuf},
+};
+use thiserror::Error;
+
+/// Invalid path supplied for a new native output file.
+#[derive(Debug, Error, PartialEq, Eq)]
+#[error("native output requires an absolute path without NUL and at most 32767 UTF-16 units")]
+pub struct OutputFilePathError;
+
+/// Describes a new native output file, without opening or reserving it yet.
+/// The DXGI constructor uses the kernel CREATE_NEW-equivalent stream operation.
+pub struct NewOutputFile {
+    path: PathBuf,
+    wide: Vec<u16>,
+}
+
+impl NewOutputFile {
+    /// Validate and bound a path without changing its Unicode or touching the filesystem.
+    pub fn new(path: &Path) -> Result<Self, OutputFilePathError> {
+        let mut wide: Vec<u16> = path.as_os_str().encode_wide().take(32768).collect();
+        if !path.is_absolute() || wide.len() >= 32768 || wide.contains(&0) {
+            return Err(OutputFilePathError);
+        }
+        wide.push(0);
+        Ok(Self {
+            path: path.into(),
+            wide,
+        })
+    }
+
+    /// The original path; validation does not normalize or canonicalize it.
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+
+    pub(super) fn wide(&self) -> &[u16] {
+        &self.wide
+    }
+}
