<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>PdfCraft Administrative Template</displayName>
  <description>Administrative policies for PdfCraft.</description>
  <resources>
    <stringTable>
      <string id="PdfCraftCategory">PdfCraft</string>
      <string id="DisableUpdateCheck">Disable update checks</string>
      <string id="DisableUpdateCheck_Explain">When enabled, PdfCraft does not check for updates and the startup-check preference is shown unchecked and disabled. When disabled or not configured, users control the automatic check in Preferences.</string>
    </stringTable>
    <presentationTable />
  </resources>
</policyDefinitionResources>
