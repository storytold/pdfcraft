  <String Id="Yes" Value="是" />
  <String Id="No" Value="否" />
  <String Id="CompleteTitle" Value="安裝成功" />
  <String Id="CompleteDescription" Value="[ProductName] 已安裝成功。按一下「完成」關閉此視窗。" />
  <String Id="Finish" Value="完成" />
  <String Id="FailedTitle" Value="安裝失敗" />
  <String Id="FailedDescription" Value="無法完成 [ProductName] 的安裝。請解決回報的錯誤，然後重新執行安裝程式。" />
  <String Id="CancelledTitle" Value="安裝已取消" />
