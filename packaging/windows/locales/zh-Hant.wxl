  <String Id="FilesInUseTitle" Value="檔案使用中" />
  <String Id="FilesInUseDescription" Value="這些程式正在使用安裝程式需要更新的檔案。按一下「確定」關閉它們並繼續，或按一下「取消」停止安裝。" />
  <String Id="OK" Value="確定" />
  <String Id="DowngradeError" Value="已安裝較新版本的 PdfCraft。" />
  <String Id="PackageDescription" Value="PdfCraft PDF 工作台" />
