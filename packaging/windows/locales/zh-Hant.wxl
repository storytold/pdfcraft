  <String Id="Language" Value="1028" />
  <String Id="Codepage" Value="950" />
  <String Id="SetupTitle" Value="[ProductName] 安裝程式" />
  <String Id="WelcomeTitle" Value="安裝 [ProductName]" />
  <String Id="WelcomeDescription" Value="安裝程式將為所有使用者安裝 [ProductName]，並將其新增至開始功能表。按一下「安裝」繼續。" />
  <String Id="WelcomeDescriptionUser" Value="安裝程式將僅為您的帳戶安裝 [ProductName]，並將其新增至開始功能表。按一下「安裝」繼續。" />
  <String Id="DesktopShortcut" Value="建立桌面捷徑" />
  <String Id="PdfContextMenu" Value="將「使用 PdfCraft 編輯」新增至 PDF 檔案的右鍵功能表" />
  <String Id="HotFolderCheckbox" Value="同時安裝 PdfCraft Hot Folder" />
  <String Id="HotFolderDescription" Value="新增隨 Windows 啟動的背景服務。僅處理您已設定並啟用的工作。" />
  <String Id="Install" Value="安裝" />
  <String Id="Cancel" Value="取消" />
  <String Id="MaintenanceTitle" Value="維護 [ProductName]" />
  <String Id="MaintenanceDescription" Value="[ProductName] 已安裝。選擇「修復」以還原遺失的檔案和捷徑，或選擇「移除」以解除安裝。" />
  <String Id="AddHotFolder" Value="新增 Hot Folder 背景服務" />
  <String Id="RemoveHotFolder" Value="移除 Hot Folder（保留工作資料）" />
  <String Id="Repair" Value="修復" />
  <String Id="Remove" Value="移除" />
