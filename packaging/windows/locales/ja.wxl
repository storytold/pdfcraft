  <String Id="SetupTitle" Value="[ProductName] セットアップ" />
  <String Id="WelcomeTitle" Value="[ProductName] のインストール" />
  <String Id="WelcomeDescription" Value="すべてのユーザー用に [ProductName] をインストールし、スタートメニューに追加します。続行するには「インストール」をクリックしてください。" />
  <String Id="WelcomeDescriptionUser" Value="お使いのアカウント専用に [ProductName] をインストールし、スタートメニューに追加します。続行するには「インストール」をクリックしてください。" />
  <String Id="DesktopShortcut" Value="デスクトップにショートカットを作成する" />
