  <String Id="Install" Value="インストール" />
  <String Id="Cancel" Value="キャンセル" />
  <String Id="MaintenanceTitle" Value="[ProductName] のメンテナンス" />
  <String Id="MaintenanceDescription" Value="[ProductName] は既にインストールされています。不足しているファイルやショートカットを復元するには「修復」、アンインストールするには「削除」を選択してください。" />
  <String Id="AddHotFolder" Value="Hot Folder バックグラウンドサービスを追加" />
  <String Id="RemoveHotFolder" Value="Hot Folder を削除（タスクデータは保持）" />
  <String Id="Repair" Value="修復" />
  <String Id="Remove" Value="削除" />
