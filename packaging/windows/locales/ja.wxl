  <String Id="Yes" Value="はい" />
  <String Id="No" Value="いいえ" />
  <String Id="CompleteTitle" Value="セットアップが正常に完了しました" />
  <String Id="CompleteDescription" Value="[ProductName] のセットアップが正常に完了しました。「完了」をクリックして、このウィンドウを閉じてください。" />
  <String Id="Finish" Value="完了" />
  <String Id="FailedTitle" Value="セットアップに失敗しました" />
