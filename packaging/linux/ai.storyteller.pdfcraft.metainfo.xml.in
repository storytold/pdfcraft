<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ai.storyteller.pdfcraft</id>
  <name>Linkco PDF Editor</name>
  <summary>Professional PDF tools for everyday document work</summary>
  <DeveloperName>Al Rawabet Commercial Services &amp; Contracting Company W.L.L.</DeveloperName>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0 OR MIT</project_license>

  <description>
    <p>
      Linkco PDF Editor is a fast, native desktop PDF reader and editor for viewing,
      searching, annotating, filling and signing forms, organizing pages, and
      preparing documents for print or distribution.
    </p>
    <p>
      All processing runs locally on your machine with no account, cloud upload,
      or telemetry.
    </p>
  </description>

  <launchable type="desktop-id">ai.storyteller.pdfcraft.desktop</launchable>
  <provides>
    <binary>pdfcraft</binary>
    <binary>pdfcraft-cli</binary>
    <mediatype>application/pdf</mediatype>
  </provides>

  <url type="homepage">https://github.com/b-lincko/linkco-pdf</url>
  <url type="bugtracker">https://github.com/b-lincko/linkco-pdf/issues</url>
  <url type="vcs-browser">https://github.com/b-lincko/linkco-pdf</url>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="@VERSION@" date="@DATE@" />
  </releases>
</component>
