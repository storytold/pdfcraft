[Desktop Entry]
Type=Application
Name=PdfChocolate
GenericName=PDF Editor
Comment=Read, organize, combine, split and secure PDFs
Exec=pdfchocolate %U
TryExec=pdfchocolate
Icon=io.github.latechocolate.pdfchocolate
Terminal=false
StartupNotify=true
StartupWMClass=io.github.latechocolate.pdfchocolate
Categories=Office;Viewer;
Keywords=pdf;viewer;editor;annotate;sign;forms;merge;split;
MimeType=application/pdf;
