public protocol EngineProtocol: AnyObject, Sendable {
    func addDrawnSignature(docId: UInt64, page: UInt32, strokes: [[FfiPoint]], author: String?) throws
    func addInkAnnotation(docId: UInt64, page: UInt32, strokes: [[FfiPoint]], colorRgb: UInt32?, strokeWidth: Float?, opacity: Float?, author: String?) throws
    func addInkStroke(docId: UInt64, stroke: FfiInkStroke) throws
    func addNoteAnnotation(docId: UInt64, page: UInt32, at: FfiPoint, contents: String, author: String?, icon: String?, colorRgb: UInt32?) throws
    func addShapeAnnotation(docId: UInt64, page: UInt32, kind: FfiShapeKind, rect: FfiRect, strokeColor: UInt32?, fillColor: UInt32?, strokeWidth: Float?, author: String?) throws
    func addStampAnnotation(docId: UInt64, page: UInt32, rect: FfiRect, stampName: String, author: String?) throws
    func addTextBoxAnnotation(docId: UInt64, page: UInt32, rect: FfiRect, contents: String, fontSize: Float, author: String?, colorRgb: UInt32?) throws
    func addTextMarkupRects(docId: UInt64, page: UInt32, rects: [FfiRect], kind: FfiTextMarkupKind, colorRgb: UInt32?, author: String?, contents: String?) throws
    func addTextMarkupSelection(docId: UInt64, page: UInt32, startGlyph: UInt32, endGlyph: UInt32, kind: FfiTextMarkupKind, colorRgb: UInt32?, author: String?, contents: String?) throws
    func addTypedSignature(docId: UInt64, page: UInt32, text: String, rect: FfiRect, author: String?) throws
    func allComments(docId: UInt64) throws  -> [FfiCommentItem]
    func applyOcrTextLayer(docId: UInt64, page: UInt32, words: [FfiOcrWord]) throws  -> UInt32
    func applyRedactions(docId: UInt64) throws  -> FfiRedactionApplyResult
    func auditRedactions(docId: UInt64) throws  -> [FfiRedactionFinding]
    func autosaveSnapshots() throws  -> [FfiRecoverySnapshot]
    func cachedTileBytes()  -> UInt64
    func cachedTileCount()  -> UInt32
    func canRedo(docId: UInt64) throws  -> String?
    func canUndo(docId: UInt64) throws  -> String?
    func cancelRenders(olderThanTag: UInt64)
    func checkAccessibility(docId: UInt64) throws  -> FfiA11yReport
    func clearRedactions(docId: UInt64) throws
    func close(docId: UInt64) throws
    func closeAll() throws
    func compareDocuments(oldDocId: UInt64, newDocId: UInt64) throws  -> [FfiDocumentChange]
    func compareDocumentsVisual(oldDocId: UInt64, newDocId: UInt64, dpi: Float?) throws  -> [FfiVisualDiff]
    func convertToPdfa(docId: UInt64, level: String) throws  -> UInt32
    func createFromImages(name: String, imageBytes: [Data]) throws  -> UInt64
    func createSelfSignedDigitalId(name: String, password: String, keyType: String, organization: String?, unit: String?, email: String?, country: String?, validityYears: UInt32) throws  -> Data
    func currentRenderTag()  -> UInt64
    func declaredStandards(docId: UInt64) throws  -> FfiPreflightDeclared
    func deleteAnnotation(docId: UInt64, page: UInt32, index: UInt32) throws
    func docInfo(docId: UInt64) throws  -> FfiDocInfo
    func documentCount()  -> UInt32
    func eraseInkAt(docId: UInt64, page: UInt32, path: [FfiPoint], radiusView: Float) throws  -> Bool
    func exportXfaDatasets(docId: UInt64) throws  -> String
    func findText(docId: UInt64, page: UInt32, query: String, caseSensitive: Bool) throws  -> [FfiFindMatch]
    func formFields(docId: UInt64, page: UInt32?) throws  -> [FfiFormField]
    func getCjkFontStatus()  -> FfiCjkFontStatus
    func getXfaStatus(docId: UInt64) throws  -> FfiXfaStatus
    func handleMemoryPressure(level: FfiMemoryPressureLevel) throws
    func hitTestAnnotation(docId: UInt64, page: UInt32, x: Float, y: Float) throws  -> FfiAnnotationSummary?
    func importXfaDatasets(docId: UInt64, datasetsXml: String) throws
    func inspectDigitalId(p12Bytes: Data, password: String?) throws  -> FfiDigitalIdInfo
    func invokeTool(name: String, argsJson: String) throws  -> FfiToolResult
    func isDirty(docId: UInt64) throws  -> Bool
    func isFormJavascriptEnabled() throws  -> Bool
    func isOcrAvailable()  -> Bool
    func listDigitalSignatures(docId: UInt64) throws  -> [FfiDigitalSignature]
    func markDocumentDifferences(oldDocId: UInt64, newDocId: UInt64) throws  -> UInt32
    func markRecovered(docId: UInt64, path: String?) throws
    func markRedactionRect(docId: UInt64, page: UInt32, rect: FfiRect, overlayText: String?) throws
    func markRedactionText(docId: UInt64, text: String, overlayText: String?) throws  -> UInt32
    func markSaved(docId: UInt64, path: String?) throws
    func moveAnnotation(docId: UInt64, page: UInt32, index: UInt32, dxView: Float, dyView: Float) throws
    func nearestGlyphAt(docId: UInt64, page: UInt32, x: Float, y: Float) throws  -> UInt32?
    func nextRenderTag()  -> UInt64
    func ocrStatus() throws  -> FfiOcrStatus
    func openBytes(name: String, bytes: Data, password: String?) throws  -> UInt64
    func openFile(pathStr: String, password: String?) throws  -> UInt64
    func outline(docId: UInt64) throws  -> [FfiOutlineItem]
    func pageComments(docId: UInt64, page: UInt32) throws  -> [FfiCommentItem]
    func pageCount(docId: UInt64) throws  -> UInt32
    func pageGeometry(docId: UInt64, page: UInt32) throws  -> FfiPageGeometry
    func pageLinks(docId: UInt64, page: UInt32) throws  -> [FfiLink]
    func pageText(docId: UInt64, page: UInt32) throws  -> String
    func planPrefetch(currentPage: UInt32, totalPages: UInt32, direction: FfiScrollDirection, lookahead: UInt32)  -> [FfiPrefetchPlan]
    func recognizePageText(docId: UInt64, page: UInt32, dpi: Float?, skipTextPages: Bool) throws  -> FfiOcrPageResult
    func redo(docId: UInt64) throws  -> String
    func renderTile(docId: UInt64, request: FfiRenderRequest) throws  -> FfiRenderResult
    func replyToComment(docId: UInt64, page: UInt32, index: UInt32, text: String, author: String) throws
    func resetForm(docId: UInt64, names: [String]?) throws
    func resizeAnnotation(docId: UInt64, page: UInt32, index: UInt32, newRectView: FfiRect) throws
    func runFormJavascript(docId: UInt64, script: String, target: String?) throws  -> FfiJsResult
    func saveBytes(docId: UInt64) throws  -> Data
    func saveToPath(docId: UInt64, targetPath: String) throws
    func setCommentContents(docId: UInt64, page: UInt32, index: UInt32, text: String) throws
    func setCommentMarked(docId: UInt64, page: UInt32, index: UInt32, marked: Bool, author: String) throws
    func setCommentReviewState(docId: UInt64, page: UInt32, index: UInt32, state: FfiReviewState, author: String) throws
    func setFormFieldCheck(docId: UInt64, name: String, checked: Bool) throws
    func setFormFieldChoice(docId: UInt64, name: String, picked: [String]) throws
    func setFormFieldRadio(docId: UInt64, name: String, selectedOption: String?) throws
    func setFormFieldText(docId: UInt64, name: String, text: String) throws
    func setFormFieldValue(docId: UInt64, name: String, value: String) throws
    func setFormJavascriptEnabled(enabled: Bool) throws
    func setOcrModelsDir(dirPath: String) throws
    func setSandboxRoot(rootPath: String) throws
    func signDocumentP12(docId: UInt64, p12Bytes: Data, password: String?, options: FfiSignOptions) throws  -> FfiSignResult
    func signFormFieldDrawn(docId: UInt64, fieldName: String, normalizedStrokes: [[FfiPoint]], author: String?) throws
    func signFormFieldTyped(docId: UInt64, fieldName: String, text: String, author: String?) throws
    func styleAnnotation(docId: UInt64, page: UInt32, index: UInt32, strokeColorRgb: UInt32?, opacity: Float?, strokeWidth: Float?, fillColorRgb: UInt32?) throws
    func takeFormJavascriptOutput(docId: UInt64) throws  -> FfiJsOutput
    func textSelectionRects(docId: UInt64, page: UInt32, startGlyph: UInt32, endGlyph: UInt32) throws  -> [FfiRect]
    func textSelectionString(docId: UInt64, page: UInt32, startGlyph: UInt32, endGlyph: UInt32) throws  -> String
    func toggleFormFieldCheck(docId: UInt64, name: String) throws  -> Bool
    func trimMemory() throws
    func undo(docId: UInt64) throws  -> String
    func verifyPdfa(docId: UInt64, level: String) throws  -> [FfiPreflightIssue]
}

